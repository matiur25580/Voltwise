NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/voltwise
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Optional MQTT bridge (use mqtts:// with a trusted TLS broker in production)
# MQTT_BROKER_URL=mqtts://broker.example.com:8883
# MQTT_USERNAME=voltwise-ingest
# MQTT_PASSWORD=replace-with-broker-password
LOG_LEVEL=info
